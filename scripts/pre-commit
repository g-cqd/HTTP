#!/usr/bin/env bash
#
# scripts/pre-commit — the in-repo counterpart to the `project-hooks` binary's pre-commit gate.
#
# Runs CI's quality check (`.ci/swift-ci run quality`, configured by .ci/action.json), so a contributor who does not
# have the `project-hooks` binary installed (see .git/hooks/pre-commit) still gets the same gate locally: swift-format
# (strict), SwiftLint (strict, the pinned release, with the project custom_rules in .swiftlint.yml: no `as Any`, no
# `.unsafelyUnwrapped`) and the analyzers against their baselines.
#
# Run it directly (`scripts/pre-commit`) or wire it as the git hook:
# `ln -sf ../../scripts/pre-commit .git/hooks/pre-commit`. The graph-level invariants (no SwiftNIO, the Aemi pin, a
# trap-free request path, RFC citations) are scripts/ci-gates.sh, which CI runs after the macOS debug tests.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
.ci/swift-ci run quality
printf '\n\033[0;32mpre-commit checks passed.\033[0m\n'
